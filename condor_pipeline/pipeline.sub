universe = vanilla
executable = /bin/bash
transfer_executable = False
arguments = pipeline_one.sh $(input_name) $(radius) $(parameters_name) $(output_suffix) $(job_key)
runtime = runtime.tar.gz
radius = 100
parameters_name = parameters.txt
jobs_file = jobs.tsv
should_transfer_files = YES
transfer_input_files = pipeline_one.sh,$(runtime),$(input_file)
transfer_output_files = result.bin,result_A_sums2,result.done
transfer_output_remaps = "result.bin=$(output_prefix)$(output_suffix);result_A_sums2=$(output_prefix)_A_sums2;result.done=$(output_prefix).done"
when_to_transfer_output = ON_EXIT
log = logs/$(ClusterId)-$(ProcId).log
output = logs/$(ClusterId)-$(ProcId).out
error = logs/$(ClusterId)-$(ProcId).err
stream_output = True
stream_error = True
accounting_group = taiga
request_cpus = 1
request_memory = 8GB
request_disk = 4GB
on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)
queue input_file,input_name,output_prefix,output_suffix,job_key from $(jobs_file)
