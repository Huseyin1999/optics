+# Dockerfile for TAIGA-IACT Simulation Runtime
+FROM rockylinux:9
+
+LABEL maintainer="TAIGA-IACT Collaboration"
+LABEL description="TAIGA-IACT Optics, Hybrid Converter and trg5 Trigger Simulation Runtime"
+
+# Enable CRB and EPEL repositories
+RUN dnf -y install epel-release dnf-plugins-core && \
+    dnf config-manager --set-enabled crb && \
+    dnf -y update && \
+    dnf -y install \
+        bash \
+        coreutils \
+        tar \
+        gzip \
+        git \
+        make \
+        gcc \
+        gcc-c++ \
+        gsl-devel \
+        libgomp \
+        which \
+        file \
+        findutils \
+        python3 \
+        python3-pip \
+        python3-devel && \
+    pip3 install --no-cache-dir --upgrade pip && \
+    pip3 install --no-cache-dir numpy pandas scipy tqdm && \
+    dnf clean all && \
+    rm -rf /var/cache/dnf /root/.cache
+
+ENV LC_ALL=C
+ENV LANG=C
+ENV LD_LIBRARY_PATH=/usr/local/lib:/usr/lib64:${LD_LIBRARY_PATH}
+
+WORKDIR /workspace
+ENTRYPOINT ["/bin/bash"]
